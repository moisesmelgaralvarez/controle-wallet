# Dependencias de herramientas (wrangler, supabase). Se reconstruyen con `npm ci`.
node_modules/

# Basura de macOS
.DS_Store

# Secretos. Ninguno debe llegar nunca al repositorio: la lista de cuáles
# existen y dónde vive cada uno está en SECRETOS.md, sin sus valores.
.env
.env.*
.dev.vars
*.pem

# …pero el EJEMPLO sí va. `.env.*` de arriba también lo atrapaba, y sin
# él quien clone el repositorio no tiene de dónde copiar ni sabe qué
# variables hacen falta. El ejemplo no lleva valores, solo los nombres.
!.env.ejemplo
!**/.env.ejemplo

# Estado local de las herramientas
.wrangler/
supabase/.temp/
supabase/.branches/

# Datos del hogar. Un respaldo exportado o un estado de cuenta del banco
# son datos financieros reales de una persona: no van a un repositorio,
# menos a uno público.
respaldos/
*.respaldo.json
estados-de-cuenta/
*.xlsx
*.pdf

# Y las capturas de pantalla, por lo mismo: una foto de la app enseña
# saldos, cuentas y nombres. Se pasan para revisar algo y se olvidan
# en la carpeta.
*.heic
*.HEIC
Captura*.png

# Preferencias locales de Claude Code, propias de esta máquina. El
# `launch.json` solo dice cómo levantar `wrangler dev` aquí: es
# herramienta de escritorio, no parte del producto.
.claude/settings.local.json
.claude/launch.json

# Los crudos de Higgsfield y los cuadros de revisión. Lo que se publica es el
# codificado en sitio/media/, no el master de 2 MB.
/revision/

# Estados de cuenta reales para las pruebas del lector de PDF. No se
# publican: son datos del hogar del dueño.
pruebas/muestras/
