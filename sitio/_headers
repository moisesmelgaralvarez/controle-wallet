# ============================================================
# Cabeceras de seguridad. Cloudflare Workers las aplica a todo lo
# que sirve desde esta carpeta.
#
# (En la app heredada este archivo decía "las aplica Netlify". Era
# un comentario viejo: aquella app se publicaba en Cloudflare Pages.
# Corregido de una vez para que no siga confundiendo.)
#
# --- Por qué una sola política y no una por sección ---
#
# La tentación es poner una CSP estricta en /* y una más abierta en
# /app/*. No se hace: /app/index.html casa con las DOS reglas, y dos
# cabeceras Content-Security-Policy no se reemplazan — el navegador
# exige cumplir ambas. La app quedaría sin poder hablar con Supabase
# y el fallo sería silencioso, que es la peor clase.
#
# Así que va una sola política, la que la app necesita. Lo que el
# sitio público pierde con eso es casi nada: `connect-src` de más no
# sirve para atacar si `script-src 'self'` ya impide que corra
# cualquier script inyectado.
# ============================================================

/*
  # La línea que más importa. script-src 'self' sin excepciones: el
  # navegador solo ejecuta los .js de este mismo sitio. Aunque
  # alguien lograra inyectar un <script> en la página, no correría.
  # Es la defensa de fondo para la sesión guardada en el dispositivo.
  #
  # style-src va SIN 'unsafe-inline', a diferencia de la app vieja.
  # Aquella lo necesitaba por 131 estilos en línea heredados. La
  # interfaz nueva se escribe sin ellos desde el primer día, porque
  # volver atrás a quitarlos después sale carísimo.
  #
  # connect-src limita a dónde puede hablar la app: solo a sí misma
  # y a Supabase. Si algo intentara mandar datos del hogar a otro
  # servidor, el navegador lo bloquea.
  #
  # DECÍA `https://*.supabase.co`, Y ESO ES CUALQUIER PROYECTO DE
  # SUPABASE, no los dos nuestros. Cualquiera puede crear uno gratis
  # en un minuto, así que el comodín autorizaba a hablar con la base
  # de un desconocido. Con `script-src 'self'` no hay hoy forma de
  # aprovecharlo —haría falta primero ejecutar código inyectado, que
  # es justo lo que esa otra línea impide— pero una defensa que
  # depende de que la de al lado no falle no es una defensa: es una
  # apuesta. Van los dos anfitriones exactos.
  #
  # Los dos, y no solo producción: `wrangler dev` y las vistas
  # previas de cada rama hablan con la base de PRUEBAS, y sirven este
  # mismo archivo. Dejar solo producción rompería el desarrollo, y lo
  # rompería en silencio.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://qhbkghxuwzdrlswphusd.supabase.co https://xidzmxtninmtxgqhddvu.supabase.co; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

  # Que nadie meta el sitio en un iframe suyo para engañar con clics
  # falsos. frame-ancestors ya lo cubre; esto es para navegadores
  # viejos que no la entienden.
  X-Frame-Options: DENY

  # Impide que el navegador adivine el tipo de un archivo y lo trate
  # como código cuando no lo es.
  X-Content-Type-Options: nosniff

  # No filtrar a dónde iban ni de dónde venían al navegar fuera.
  Referrer-Policy: strict-origin-when-cross-origin

  # Apagar capacidades que no se usan. La cámara queda permitida
  # porque el escaneo de facturas la necesita.
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=(), magnetometer=()

  # Un año de HTTPS obligatorio. Cloudflare ya lo manda por su
  # cuenta; declararlo aquí lo deja escrito en el repositorio, que
  # es donde tiene que estar para que nadie lo apague sin que quede
  # constancia.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ------------------------------------------------------------
  # NADIE TRANSFORMA ESTAS PÁGINAS. NI SIQUIERA QUIEN LAS SIRVE.
  #
  # `no-transform` le dice a cualquier intermediario —Cloudflare
  # incluido— que la respuesta llega como salió. No es teoría: la
  # analítica web de Cloudflare INYECTABA su `beacon.min.js` en cada
  # página, y como la CSP dice `script-src 'self'` el navegador lo
  # rechazaba. Resultado medido en producción: un error de consola en
  # cada visita, y una analítica que no funcionaba.
  #
  # Pero el motivo de fondo no es el error. Es que
  # `sitio/privacidad.html` promete, con estas palabras: «No usamos
  # publicidad ni rastreadores de terceros. No hay Google Analytics,
  # ni píxeles, ni cookies de seguimiento». El beacon era exactamente
  # eso, y estaba recolectando hasta las rutas de `/app/**`, donde hay
  # sesión iniciada. El sitio contradecía su propia política.
  #
  # La documentación de Cloudflare dice que la inyección automática no
  # puede aplicarse sobre respuestas `no-transform`. Así que esta línea
  # apaga el beacon Y todo lo que venga después —Rocket Loader,
  # ofuscación de correos, minificado— sin depender de que nadie
  # recuerde dejar un interruptor apagado en un panel.
  #
  # Va solo en `/*`, que en este archivo son las PÁGINAS. La
  # compresión no es una transformación en este sentido y no se ve
  # afectada: se negocia por `Content-Encoding`.
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# ============================================================
# LO ESTÁTICO: SE COMPRIME Y SE GUARDA
#
# `no-transform` en `/*` apaga la inyección del beacon de Cloudflare —por
# eso está, y se queda— pero apaga TAMBIÉN la compresión, y eso no se
# había medido. Medido ahora, en producción: la portada baja 152 KB de CSS
# sin comprimir, cuando comprimida son unos 20. `papel.css` sola pesa
# 111 KB y la usan todas las páginas.
#
# El beacon solo se inyecta en documentos HTML. Así que estas reglas
# devuelven la compresión a lo que NO es una página, sin tocar la defensa
# donde importa. Las páginas siguen con `no-transform` por `/*`.
#
# CÓMO SE COMPRUEBA, y hay que hacerlo después de publicar, porque esto no
# se puede probar en local:
#
#   curl -sI --compressed https://controlewallet.com/papel.css | grep -i 'content-encoding\|cache-control'
#
# Tiene que decir `content-encoding: br` (o gzip) y una sola línea de
# `cache-control` SIN `no-transform`. Si aparece `no-transform` ahí, las
# dos reglas se están sumando en vez de pisarse: entonces la salida es
# listar las páginas una por una arriba y quitar `no-transform` de `/*`.
# ============================================================

# La tipografía no cambia nunca: su contenido ES la fuente. Un año.
/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

# Las películas y sus pósters se regeneran con el mismo nombre cuando
# cambia la interfaz, así que una semana y a revalidar.
/media/*
  Cache-Control: public, max-age=604800, must-revalidate

# Hojas, guiones e iconos: una hora en el navegador, y revalidación
# después. Son los archivos que más cambian de los que no son páginas.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate
/*.js
  Cache-Control: public, max-age=3600, must-revalidate
/*.svg
  Cache-Control: public, max-age=3600, must-revalidate
/*.png
  Cache-Control: public, max-age=604800, must-revalidate
/*.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate
